.
├── main.c                        # Main application entry point
│
├── lib/
│   ├── sysType.h                # Common platform definitions
│   └── rp2040/                  # RP2040-specific hardware drivers
│       ├── rp2040_gpio.[c|h]
│       ├── rp2040_pwm.[c|h]
│       └── rp2040_spi.[c|h]
│
└── src/                         # Platform-agnostic HALs and motor logic
    ├── encoder/
    │   ├── AS5048A.[c|h]        # AS5048A encoder driver
    │   └── encoder_hal.[c|h]    # Encoder abstraction layer
    │
    ├── gpio/
    │   ├── gpio_hal.[c|h]       # GPIO abstraction
    │
    ├── pwm/
    │   ├── pwm_hal.[c|h]        # PWM abstraction
    │
    ├── spi/
    │   ├── spi_hal.[c|h]        # SPI abstraction
    │
    └── motor_control/
        ├── motor_control.[c|h]  # Motor control algorithms
        └── motor_hal.[c|h]      # Hardware abstraction for motor control
