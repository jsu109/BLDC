BLDC_testApp/
├── CMakeLists.txt                  # Top-level CMake file
├── pico_sdk_import.cmake          # SDK import file (as per Pico setup)
│
├── src/                            # Application source files (.c)
│   ├── main.c                      # Entry point
│   ├──/motor_control
|   |   ├── motor_control.h / .c    # Hardware-independent, high-level logic (e.g., speed control, commutation logic)
|   |   ├── motor_hal.h / .c        # Hardware Abstraction Layer (HAL): wraps low-level functions (PWM, GPIO, SPI)
|   |   └── motor_types.h           # Common enums, structs, typedefs shared across the module
│   |
|   ├── encoder.c                  # AS5080A SPI read logic
│   ├── pwm_driver.c               # PWM setup and control
│   ├── utils.c                    # Optional: general utilities (e.g. angle math)
│
├── lib/                            # Header files (.h)
│   ├── utils.h
│
├── build/                          # CMake build output (ignored by git)
│   └── ...
│
├── README.md                       # Project documentation
├── .gitignore                      # If using git


